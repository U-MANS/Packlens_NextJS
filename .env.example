NEXT_PUBLIC_API_URL=/api/v1

# Registro debug público (/auth/debug/register). DEBE ser false en cualquier despliegue.
# Solo útil en local: además requiere NODE_ENV !== production.
NEXT_PUBLIC_DEBUG_SIGNUP=false
DEBUG_ENABLE_SIGNUP=false

# ── Instancia (1 Vercel + 1 Supabase = 1 cliente) ────────────────────────────
# Opcional si hay más de una org en la DB:
# DEFAULT_ORGANIZATION_ID=
# DEFAULT_ORGANIZATION_SLUG=packaging-wework

# Credenciales del proyecto Supabase de ESTE cliente
# Dashboard → Settings → API Keys (Publishable and secret)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_STORAGE_BUCKET=packlens-files

# Legacy (opcional, fallback):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

FRONTEND_BASE_URL=http://localhost:3000

# Email invitaciones (Brevo / Sendinblue)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=cristian@weworkfactory.com
BREVO_SENDER_NAME=PackLens

# OpenAI — Moodboard IA (GPT Image)
OPENAI_API_KEY=sk-...
# gpt-image-2.5-flare (rápido) | gpt-image-2.5-sunburst (edición/precisión)
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
