NEXT_PUBLIC_API_URL=/api/v1

# Registro debug público (/auth/debug/register). DEBE ser false en cualquier despliegue.
# Solo útil en local: además requiere NODE_ENV !== production.
NEXT_PUBLIC_DEBUG_SIGNUP=false
DEBUG_ENABLE_SIGNUP=false

# Multi-tenant (misma DB + organization_id). false = Helios implícita (comportamiento previo).
MULTI_TENANT=true
NEXT_PUBLIC_MULTI_TENANT=true

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=packlens-files

FRONTEND_BASE_URL=http://localhost:3000

# Email invitaciones (Brevo / Sendinblue)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=cristian@weworkfactory.com
BREVO_SENDER_NAME=PackLens

# OpenAI — Moodboard IA (GPT Image)
OPENAI_API_KEY=sk-...
# gpt-image-2.5-flare (rápido) | gpt-image-2.5-sunburst (edición/precisión)
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
